{
  "_说明": "MCP 服务器配置 — 每加入一个服务器，Agent 就多一组工具。配置后重启即生效。",

  "_推荐_文件系统增强": {
    "作用": "补上搜索/编辑/目录树/文件信息 — 当前工具的最大缺口",
    "安装": "pnpm add @modelcontextprotocol/server-filesystem",
    "配置方式": "将此对象复制到下方 mcpServers 中",
    "transport": "stdio",
    "command": "node",
    "args": ["./node_modules/@modelcontextprotocol/server-filesystem/dist/index.js", "."],
    "新增工具": "search_files, directory_tree, edit_file, move_file, read_multiple_files, get_file_info 等 14 个"
  },

  "_推荐_GitHub": {
    "作用": "让 Agent 能创建 Issue、PR、管理仓库",
    "需要": "GitHub Personal Access Token",
    "安装": "pnpm add @modelcontextprotocol/server-github",
    "配置方式": "安装后，将此对象复制到下方 mcpServers 中，填入你的 token",
    "transport": "stdio",
    "command": "node",
    "args": ["./node_modules/@modelcontextprotocol/server-github/dist/index.js"],
    "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_xxxxxxxxxxxx" },
    "新增工具": "create_issue, list_issues, create_pull_request, search_repositories, get_file_contents"
  },

  "mcpServers": {
    "filesystem": {
      "transport": "stdio",
      "command": "node",
      "args": ["./node_modules/@modelcontextprotocol/server-filesystem/dist/index.js", "."]
    }
  }
}
